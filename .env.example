# Copia este archivo a .env y ajusta los valores locales. No pongas secretos reales aqui.

# --- Base de datos (Postgres local via docker-compose.yml, puerto 5433 en el host) ---
DATABASE_URL="postgresql://vonveria:vonveria_dev_password@localhost:5433/vonveria_swim?schema=public"

# --- General ---
NODE_ENV="development"
TZ="America/Mexico_City"
DEFAULT_CURRENCY="MXN"

# --- apps/api ---
API_PORT=3001
API_CORS_ORIGIN="http://localhost:3100"

# --- apps/web (puerto 3100, no 3000, para no chocar con otros proyectos locales) ---
WEB_PORT=3100
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- apps/worker ---
WORKER_HEARTBEAT_INTERVAL_MS=60000

# --- Seed (usuario Direccion de la escuela piloto simulada) ---
# NUNCA commitear contraseñas reales. Cada ambiente debe generar la suya con openssl:
# openssl rand -base64 24 | tr -d '=' | head -c 32
ADMIN_EMAIL="direccion@piloto.vonveria.mx"
ADMIN_PASSWORD="GENERAR_NUEVA_PARA_CADA_AMBIENTE"

# --- Mailer (para dev, usar mailtrap.io free tier) ---
MAILER_HOST="live.smtp.mailtrap.io"
MAILER_PORT=587
MAILER_USER="tu-usuario-de-mailtrap"
MAILER_PASS="tu-contraseña-de-mailtrap"
MAILER_FROM="noreply@vonveria.mx"
FRONTEND_URL="http://localhost:3100"
