# Copia este archivo a .env y ajusta los valores locales. No pongas secretos reales aqui.

# --- Base de datos (Postgres local via docker-compose.yml, puerto 5433 en el host) ---
DATABASE_URL="postgresql://vonveria:vonveria_dev_password@localhost:5433/vonveria_swim?schema=public"

# --- General ---
NODE_ENV="development"
TZ="America/Mexico_City"
DEFAULT_CURRENCY="MXN"

# --- apps/api ---
API_PORT=3001
API_CORS_ORIGIN="http://localhost:3100"

# --- apps/web (puerto 3100, no 3000, para no chocar con otros proyectos locales) ---
WEB_PORT=3100
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- apps/worker ---
WORKER_HEARTBEAT_INTERVAL_MS=60000

# --- Seed (usuario Direccion de la escuela piloto simulada, no un secreto real) ---
ADMIN_EMAIL="direccion@piloto.vonveria.mx"
ADMIN_PASSWORD="CambiaEstaClave123!"
