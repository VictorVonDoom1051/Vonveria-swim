{
  "name": "vonveria-swim",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma para administrar escuelas de natacion (VonverIA Swim)",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --if-present --filter \"./apps/*\" --filter \"./packages/*\" build",
    "start": "pnpm --filter @vonveria-swim/web start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "test": "pnpm --recursive --if-present --filter \"./apps/*\" --filter \"./packages/*\" test",
    "db:generate": "dotenv -e .env -- pnpm --filter @vonveria-swim/database prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @vonveria-swim/database prisma:migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter @vonveria-swim/database prisma:deploy",
    "db:studio": "dotenv -e .env -- pnpm --filter @vonveria-swim/database prisma:studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @vonveria-swim/database seed",
    "railway:migrate-seed": "pnpm --filter @vonveria-swim/database exec prisma migrate deploy && pnpm --filter @vonveria-swim/database run seed",
    "db:import": "dotenv -e .env -- pnpm --filter @vonveria-swim/database import"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
